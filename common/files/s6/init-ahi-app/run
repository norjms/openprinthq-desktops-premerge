#!/usr/bin/with-contenv bash
# OpenPrintHQ: the app's own settings, from /etc/ahi/app.env (each app's folder in openprinthq-desktops). Only a
# new /config gets the dark mode; a settings file that exists is never rewritten wholesale, so a person's own
# choices stay theirs. Apps that can hand a file to their running window (APP_SINGLE_INSTANCE) get that turned
# on, and the session bus (svc-ahi-bus) named in labwc's environment, so a file sent from the farm joins the
# open window instead of starting a second one.
source /etc/ahi/app.env

if [[ -n "${APP_CONF:-}" && -n "${APP_CONF_NEW:-}" && ! -e "${APP_CONF}" ]]; then
  mkdir -p "$(dirname "${APP_CONF}")"
  printf '%b' "${APP_CONF_NEW}" > "${APP_CONF}"
  chown -R abc:abc /config/.config
  echo "[ahi-init] ${APP_TITLE} starts with the OpenPrintHQ settings"
fi

if [[ "${APP_SINGLE_INSTANCE:-}" == "json" && -f "${APP_CONF}" ]]; then
  if grep -q '"single_instance": false' "${APP_CONF}"; then
    sed -i 's/"single_instance": false/"single_instance": true/' "${APP_CONF}"
  elif ! grep -q '"single_instance"' "${APP_CONF}"; then
    sed -i '0,/"app": {/s//"app": {\n\t\t"single_instance": true,/' "${APP_CONF}"
  fi
fi

# The same for an app whose settings are an INI file (PrusaSlicer): the key among the file's first lines, before
# any section, where such apps keep their own settings.
if [[ "${APP_SINGLE_INSTANCE:-}" == "ini" && -f "${APP_CONF}" ]]; then
  if grep -q '^single_instance = 0$' "${APP_CONF}"; then
    sed -i 's/^single_instance = 0$/single_instance = 1/' "${APP_CONF}"
  elif ! grep -q '^single_instance = ' "${APP_CONF}"; then
    sed -i '1i single_instance = 1' "${APP_CONF}"
  fi
  chown abc:abc "${APP_CONF}"
fi

LABWC_ENV="/config/.config/labwc/environment"
mkdir -p "$(dirname "${LABWC_ENV}")"
touch "${LABWC_ENV}"
grep -v '^DBUS_SESSION_BUS_ADDRESS=' "${LABWC_ENV}" > "${LABWC_ENV}.ahi" || true
printf 'DBUS_SESSION_BUS_ADDRESS=unix:path=%s/ahi-bus\n' "${XDG_RUNTIME_DIR:-/config/.XDG}" >> "${LABWC_ENV}.ahi"
grep -q '^NO_AT_BRIDGE=' "${LABWC_ENV}.ahi" || printf 'NO_AT_BRIDGE=1\n' >> "${LABWC_ENV}.ahi"
mv "${LABWC_ENV}.ahi" "${LABWC_ENV}"
chown -R abc:abc /config/.config/labwc

# Apps with a setup step of their own (a Wine app installing the vendor's build into /config) run it here.
if [[ -x /etc/ahi/app-init ]]; then
  /etc/ahi/app-init
fi
