# Creality Print's settings for the shared start-up steps (common/files/s6). Read as shell by init-ahi-app,
# init-ahi-files and svc-ahi-inbox. Its settings are JSON, as OrcaSlicer's and Bambu Studio's, in a folder named
# for its version (7.3). A new one starts in dark mode with files sent from the farm joining the running window.
APP_TITLE="Creality Print"
APP_CONF="/config/.config/Creality/Creality Print/7.3/Creality.conf"
APP_CONF_NEW='{\n    "app": {\n        "dark_color_mode": "1",\n        "single_instance": true\n    }\n}\n'
APP_SINGLE_INSTANCE=json
APP_FILES_DEFAULTS=json
APP_PROCESS=/opt/crealityprint/bin/CrealityPrint
APP_RUN=/opt/crealityprint/AppRun
