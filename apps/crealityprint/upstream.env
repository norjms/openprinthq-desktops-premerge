# The linuxserver.io Selkies base image Creality Print is installed on (linuxserver.io publishes no Creality
# Print image), by tag and the digest that tag must be, as linuxserver.io's own Bambu Studio image is built.
UPSTREAM_IMAGE=ghcr.io/linuxserver/baseimage-selkies
UPSTREAM_VERSION=ubunturesolute
UPSTREAM_DIGEST=sha256:c4973383c264703f5e4f96508b661065df4d32986b37b3ebb3ed25b8660eae67
# Creality Print's own Linux build (AGPL-3.0, from CrealityOfficial/CrealityPrint's release), checked against
# the hash its release publishes. Linux x86_64 only.
APP_VERSION=7.3.2
APP_URL=https://github.com/CrealityOfficial/CrealityPrint/releases/download/v7.3.2/CrealityPrint-V7.3.2.6412-x86_64-Release.AppImage
APP_SHA256=8bb5dc45a8dc5a3cbc8def89cfb8e36fcd19c839b77e9e8b622d97624b0ff05a
# The architectures built (the release build reads this).
PLATFORMS=linux/amd64
UPSTREAM_REPO=https://github.com/linuxserver/docker-baseimage-selkies
# The fonts the web desktop's page is set in, from the fontsource packages (SIL Open Font License 1.1).
FONTSOURCE_VERSION=5.3.0
