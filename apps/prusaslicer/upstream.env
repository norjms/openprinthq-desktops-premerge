# The linuxserver.io Selkies base image PrusaSlicer is installed on (linuxserver.io publishes no PrusaSlicer
# image), by tag and the digest that tag must be, so a moved tag fails the build instead of changing what is
# built. PrusaSlicer itself is Debian's package, at the version named here.
UPSTREAM_IMAGE=ghcr.io/linuxserver/baseimage-selkies
UPSTREAM_VERSION=debiantrixie
UPSTREAM_DIGEST=sha256:793fc3628ad6e089aecfd9f862de3ad5d9df05f1db783363c812f77d6541ccc3
# Debian trixie's prusa-slicer (built by Debian from PrusaSlicer's source, AGPL-3.0). Prusa's own Linux builds
# are on Flathub only since 2.9.
APP_PACKAGE_VERSION=2.9.2+dfsg-1
# The image's tag: the PrusaSlicer version it carries.
APP_VERSION=2.9.2
# The architectures the base image is published for, and so the ones built (the release build reads this).
PLATFORMS=linux/amd64,linux/arm64
UPSTREAM_REPO=https://github.com/linuxserver/docker-baseimage-selkies
# The fonts the web desktop's page is set in, from the fontsource packages (SIL Open Font License 1.1).
FONTSOURCE_VERSION=5.3.0
