# PrusaSlicer's settings for the shared start-up steps (common/files/s6). Read as shell by init-ahi-app,
# init-ahi-files and svc-ahi-inbox. PrusaSlicer follows the desktop's dark GTK theme on Linux, so a new
# settings file needs nothing for the dark mode; it starts with files sent from the farm joining the running
# window and the Files folders as where it opens and exports.
APP_TITLE="PrusaSlicer"
APP_CONF=/config/.config/PrusaSlicer/PrusaSlicer.ini
APP_CONF_NEW='single_instance = 1\n'
APP_SINGLE_INSTANCE=ini
APP_FILES_DEFAULTS=ini
APP_PROCESS=/usr/bin/prusa-slicer
APP_RUN=/usr/bin/prusa-slicer
