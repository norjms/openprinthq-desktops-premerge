# Bambu Suite's settings for the shared start-up steps (common/files/s6) and for common/wine/ahi-wine-app, which
# installs it on the desktop's first start and starts it. Read as shell. Its own settings are Windows ones inside
# its Wine prefix, so the OpenPrintHQ settings files (APP_CONF) do not apply.
APP_TITLE="Bambu Suite"
APP_PROCESS="BambuSuite.exe"
APP_RUN=/usr/local/bin/ahi-wine-app
WINE_APP_ID=bambusuite
WINE_APP_VENDOR="Bambu Lab"
WINE_APP_URL=https://public-cdn.bblmw.com/general_pkg/prod/setup/20260922_143208_30/BambuSuite_Public_Win_01.05.00.00.exe
WINE_APP_SHA256=d325fdc9e27b62ff19aa21c7b8d01226f763ff1be96fe9888418debc38412d86
WINE_APP_INSTALL=inno
WINE_APP_EXE="Program Files/Bambu Suite/BambuSuite.exe"
WINE_APP_ARGS=""
