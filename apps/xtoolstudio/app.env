# xTool Studio's settings for the shared start-up steps (common/files/s6) and for common/wine/ahi-wine-app, which
# installs it on the desktop's first start and starts it. Read as shell. Its own settings are Windows ones inside
# its Wine prefix, so the OpenPrintHQ settings files (APP_CONF) do not apply.
APP_TITLE="xTool Studio"
APP_PROCESS="xTool Studio.exe"
APP_RUN=/usr/local/bin/ahi-wine-app
WINE_APP_ID=xtoolstudio
WINE_APP_VENDOR="xTool"
WINE_APP_URL=https://storage.atomm.com/efficacy/atomm-package/packages/109/584a8bb9-accb-49a1-8299-34e9dacf53bf/xTool-Studio-x64-1.11.9.exe
WINE_APP_SHA256=2619c6b4c4a935ce51522112aecfac8390a719e1391e46e6d59100536534cdb5
# xTool's NSIS installer leaves an empty folder under Wine: the app is unpacked from it instead (as xTool Studio
# LinuxBox does).
WINE_APP_INSTALL=electron-7z
WINE_APP_EXE="users/abc/AppData/Local/Programs/xTool Studio/xTool Studio.exe"
# Chromium inside xTool Studio draws with SwiftShader through ANGLE: the desktop has no GPU, and Wine has no
# DirectComposition (as xTool Studio LinuxBox found).
WINE_APP_ARGS="--use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader --disable-direct-composition --ignore-gpu-blocklist"
