# The linuxserver.io Bambu Studio image this desktop is built from. Only published version tags are taken
# (never latest), and the tag must still be the digest named here, so a moved tag fails the build instead of
# changing what is built. The three image lines move together.
UPSTREAM_IMAGE=lscr.io/linuxserver/bambustudio
UPSTREAM_VERSION=v02.09.01.70-ls180
UPSTREAM_DIGEST=sha256:8623b30b1a1f569b3704509ef8cbfc6fa4a76876737429f7cfb6eeb9335e3ae9
# The architectures the upstream image is published for, and so the ones built (the release build reads this).
PLATFORMS=linux/amd64
UPSTREAM_REPO=https://github.com/linuxserver/docker-bambustudio
# The fonts the web desktop's page is set in, from the fontsource packages (SIL Open Font License 1.1).
FONTSOURCE_VERSION=5.3.0
