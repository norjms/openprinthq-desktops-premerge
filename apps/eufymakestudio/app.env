# eufyMake Studio's settings for the shared start-up steps (common/files/s6) and for common/wine/ahi-wine-app, which
# installs it on the desktop's first start and starts it. Read as shell. Its own settings are Windows ones inside
# its Wine prefix, so the OpenPrintHQ settings files (APP_CONF) do not apply.
APP_TITLE="eufyMake Studio"
APP_PROCESS="eufymake studio.exe"
APP_RUN=/usr/local/bin/ahi-wine-app
WINE_APP_ID=eufymakestudio
WINE_APP_VENDOR="eufyMake"
WINE_APP_URL=https://public-make-moat-us.s3.us-east-2.amazonaws.com/eufymake/pc/installers/global/AnkerMakeStudio_Installer_Windows.exe
# No WINE_APP_SHA256: the vendor publishes this installer at one address that each release replaces, so
# there is no fixed hash to hold it to; it is fetched over HTTPS from the vendor's own storage.
WINE_APP_INSTALL=nsis
WINE_APP_EXE="users/abc/AppData/Local/eufyMake Studio/eufymake studio.exe"
WINE_APP_ARGS=""
