# The linuxserver.io Selkies base image eufyMake Studio's desktop is built on, by tag and the digest that tag must be,
# so a moved tag fails the build instead of changing what is built.
UPSTREAM_IMAGE=ghcr.io/linuxserver/baseimage-selkies
UPSTREAM_VERSION=debiantrixie
UPSTREAM_DIGEST=sha256:793fc3628ad6e089aecfd9f862de3ad5d9df05f1db783363c812f77d6541ccc3
# Wine, from WineHQ's Debian trixie repository, at this package version. The image holds Wine only: eufyMake Studio is
# eufyMake's Windows software, downloaded from eufyMake when the desktop first starts (app.env's WINE_APP_URL).
APP_PACKAGE_VERSION=11.0.0.0~trixie-1
# The image's tag: the eufyMake Studio version its first start installs.
APP_VERSION=5.1.3
# Wine's Windows apps here are x86-64 only.
PLATFORMS=linux/amd64
UPSTREAM_REPO=https://github.com/linuxserver/docker-baseimage-selkies
# The fonts the web desktop's page is set in, from the fontsource packages (SIL Open Font License 1.1).
FONTSOURCE_VERSION=5.3.0
